+      this.closing = null
+      this.pending = null
+      this.timer = null
+      this.stableTimer = null
+      this.attempts = 0
+      this.stopped = false
+   }
+
+   start() {
+      if (this.stopped) return Promise.resolve(null)
+      if (this.pending) return this.pending
+      if (this.closing) return this.closing.then(() => this.start())
+      if (this.socket) return Promise.resolve(this.socket)
