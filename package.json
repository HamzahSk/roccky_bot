{
   "name": "ROCKYY",
   "version": "0.2.2",
   "description": "A simple WhatsApp bot built on Baileys",
   "main": "index.js",
   "type": "module",
   "imports": {
      "#func": "./lib/Function/index.js",
      "#scrap": "./lib/Scraper/index.js",
      "#utils": "./lib/Utils/index.js"
   },
   "scripts": {
      "start": "NODE_ENV=production bun index.js",
      "start:node": "NODE_ENV=production MALLOC_ARENA_MAX=2 node --max-old-space-size=300 --expose-gc index.js",
      "start:api": "node AI-SEERVER/api/index.js",
      "start:api:bun": "bun AI-SEERVER/api/index.js",
      "dev": "bun --watch index.js",
      "test": "node --test test/*.test.js agent/test/*.test.js ro-lang/test/*.test.js AI-SEERVER/test/*.test.js"
   },
   "engines": {
      "node": ">=22.12.0"
   },
   "repository": {
      "type": "git",
      "url": "git+https://github.com/HamzahSk/roccky_bot.git"
   },
   "keywords": [
      "automation",
      "base",
      "baileys",
      "bot",
      "js-whatsapp",
      "multi-device",
      "rockyy",
      "whatsapp",
      "whatsapp-bot"
   ],
   "homepage": "https://github.com/HamzahSk/roccky_bot#readme",
   "author": "Lia Wynn",
   "license": "Apache-2.0",
   "dependencies": {
      "@hapi/boom": "^10.0.1",
      "@hono/node-server": "^1.14.0",
      "@napi-rs/image": "^1.12.0",
      "awesome-phonenumber": "~2.59.0",
      "axios": "^1.13.5",
      "baileys": "npm:@rexxhayanasi/elaina-baileys@1.4.7",
      "chalk": "^5.6.2",
      "cheerio": "^1.2.0",
      "fflate": "^0.8.3",
      "file-type": "21.3.4",
      "fluent-ffmpeg": "^2.1.3",
      "form-data": "^4.0.4",
      "gtts": "^0.2.1",
      "hono": "^4.7.0",
      "mongodb": "^7.2.0",
      "node-cache": "^5.1.2",
      "pg": "^8.21.0",
      "pino": "^9.6.0",
      "qrcode": "~1.5.4",
      "sharp": "^0.33.5",
      "yt-search": "^2.13.1",
      "lru-cache": "^11.5.3",
      "p-queue": "^9.3.5",
      "undici": "^7.30.2",
      "ws": "^8.22.1"
   },
   "packageManager": "bun@1.4.4"
}
