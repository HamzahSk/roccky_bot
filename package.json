{
   "name": "ROCKYY",
   "version": "0.2.2",
   "description": "A simple WhatsApp bot built on Baileys",
   "main": "index.js",
   "type": "module",
   "imports": {
      "#func": "./lib/Function/index.js",
      "#scrap": "./lib/Scraper/index.js",
      "#utils": "./lib/Utils/index.js"
   },
   "scripts": {
      "start": "NODE_ENV=production bun index.js",
      "start:node": "NODE_ENV=production MALLOC_ARENA_MAX=2 node --max-old-space-size=300 --expose-gc index.js",
      "dev": "bun --watch index.js"
   },
   "engines": {
      "node": ">=20.18.1"
   },
   "repository": {
      "type": "git",
      "url": "git+https://github.com/itsliaaa/starseed.git"
   },
   "keywords": [
      "automation",
      "base",
      "baileys",
      "bot",
      "js-whatsapp",
      "multi-device",
      "rockyy",
      "whatsapp",
      "whatsapp-bot"
   ],
   "homepage": "https://github.com/itsliaaa/starseed#readme",
   "author": "Lia Wynn",
   "license": "Apache-2.0",
   "dependencies": {
      "@hapi/boom": "^10.0.1",
      "@napi-rs/image": "^1.12.0",
      "awesome-phonenumber": "~2.59.0",
      "axios": "^1.13.5",
      "baileys": "npm:@whiskeysockets/baileys",
      "chalk": "^5.6.2",
      "cheerio": "^1.2.0",
      "file-type": "21.3.4",
      "gtts": "^0.2.1",
      "mongodb": "^7.2.0",
      "node-cache": "^5.1.2",
      "pg": "^8.21.0",
      "pino": "^9.6.0",
      "qrcode": "~1.5.4",
      "sharp": "^0.33.5",
      "yt-search": "^2.13.1"
   },
   "packageManager": "bun@latest"
}